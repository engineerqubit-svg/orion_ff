# ---------------------------------------------------------------------------
# QUBIT FRIDAY ARENA
# Everything here is optional. With no .env at all the app runs fully locally:
# in-memory storage + SSE realtime, which is enough to host a real game night
# on one machine.
# ---------------------------------------------------------------------------

# Host sign-in (mocked auth — replace with a real IdP before external exposure)
ADMIN_EMAIL=orion@qubit.local
ADMIN_PASSWORD=orion@996
ADMIN_SESSION_SECRET=change-me-in-production

# --- Persistence -----------------------------------------------------------
# "memory" (default when no table is set) or "dynamodb"
# DATA_PROVIDER=dynamodb
# DYNAMODB_TABLE_NAME=qubit-friday-arena
# AWS_REGION=ap-south-1

# --- Realtime --------------------------------------------------------------
# "local" = Server-Sent Events through this Next.js server (default).
# "aws"   = API Gateway WebSocket. Requires both variables below.
# NEXT_PUBLIC_REALTIME_PROVIDER=aws
# NEXT_PUBLIC_WEBSOCKET_URL=wss://xxxx.execute-api.ap-south-1.amazonaws.com/prod
# WEBSOCKET_MANAGEMENT_ENDPOINT=https://xxxx.execute-api.ap-south-1.amazonaws.com/prod
